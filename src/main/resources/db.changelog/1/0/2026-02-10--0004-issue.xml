<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.0.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <changeSet id="2026-02-10--0004-issue" author="dkuzmin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="issue"/>
            </not>
        </preConditions>

        <createTable tableName="issue">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="issue_date" type="DATE">
                <constraints nullable="false"/>
            </column>

            <column name="return_date" type="DATE">
                <constraints nullable="false"/>
            </column>

            <column name="returned_at" type="DATE"/>

            <column name="employee_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_issue_employee" referencedTableName="employee"
                             referencedColumnNames="id"/>
            </column>

            <column name="equipment_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_issue_equipment" referencedTableName="equipment"
                             referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
